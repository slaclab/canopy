{
  "about": [
    "Route vectors for POST <ws>/claim.",
    "Authored in canopy (tests/canopy_mcp/fixtures/workspace/); every other holder keeps a byte-identical copy of the whole directory.",
    "ASCII-only, no trailing whitespace, exactly one final newline.",
    "Route vectors for the workspace's HTTP surface on FRONT. path is relative to the advertised workspace path (config.json workspace.path); there is no route that accepts commands.",
    "Each case: setup steps (the scenarios' step grammar, on a fresh hub with epoch e1 and the clock at 0), one request {method, path, headers?, body?, padTo?}, expect {status, body?, events?}, then optional follow-up steps.",
    "A body {'$file': <name>} is that fixture file's body (state.sample.json, state.oversize.json, state.reduced.json); state '$sample' / '$empty' as in the scenarios. padTo: once those are resolved, the body's compact JSON followed by spaces up to that many bytes.",
    "A claim or report body is {windowId, seq, shown, state, truncated?}; truncated is true when the window reduced an oversize state. An error body is {code, detail}; expect names the code only.",
    "Every workspace route, the event stream included, refuses a Sec-Fetch-Site that is present and neither same-origin nor none with 403 cross_site, before it reads the body or the hub.",
    "Bodies are at most 131072 bytes (413 too_large); a state that breaks the hub's normalisation is 422 invalid_state."
  ],
  "route": "claim",
  "cases": [
    {
      "name": "a claim always wins and names the window it replaced",
      "setup": [
        {
          "actor": "window:A",
          "do": "claim",
          "seq": 41,
          "shown": true,
          "state": "$sample",
          "expect": {
            "status": 200,
            "body": {
              "active": true,
              "previous": null,
              "epoch": "e1"
            }
          }
        },
        {
          "actor": "window:A",
          "do": "connect",
          "expect": {
            "status": 200,
            "events": [
              {
                "event": "hello",
                "data": {
                  "epoch": "e1",
                  "activeWindow": "w-A",
                  "seq": 41
                }
              }
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "path": "claim",
        "body": {
          "windowId": "w-B",
          "seq": 1,
          "shown": true,
          "state": "$empty"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "active": true,
          "previous": "w-A",
          "epoch": "e1"
        }
      },
      "then": [
        {
          "actor": "window:A",
          "do": "receive",
          "expect": {
            "events": [
              {
                "event": "inactive"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "the first claim has no previous window",
      "setup": [],
      "request": {
        "method": "POST",
        "path": "claim",
        "body": {
          "windowId": "w-A",
          "seq": 41,
          "shown": true,
          "state": "$sample"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "active": true,
          "previous": null,
          "epoch": "e1"
        }
      }
    },
    {
      "name": "if_vacant fails while another window is connected",
      "setup": [
        {
          "actor": "window:A",
          "do": "claim",
          "seq": 41,
          "shown": true,
          "state": "$sample",
          "expect": {
            "status": 200,
            "body": {
              "active": true,
              "previous": null,
              "epoch": "e1"
            }
          }
        },
        {
          "actor": "window:A",
          "do": "connect",
          "expect": {
            "status": 200,
            "events": [
              {
                "event": "hello",
                "data": {
                  "epoch": "e1",
                  "activeWindow": "w-A",
                  "seq": 41
                }
              }
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "path": "claim?if_vacant=1",
        "body": {
          "windowId": "w-B",
          "seq": 1,
          "shown": true,
          "state": "$empty"
        }
      },
      "expect": {
        "status": 409,
        "body": {
          "code": "not_vacant"
        }
      }
    },
    {
      "name": "a cross-site claim",
      "setup": [],
      "request": {
        "method": "POST",
        "path": "claim",
        "headers": {
          "Sec-Fetch-Site": "cross-site"
        },
        "body": {
          "windowId": "w-A",
          "seq": 41,
          "shown": true,
          "state": "$sample"
        }
      },
      "expect": {
        "status": 403,
        "body": {
          "code": "cross_site"
        }
      },
      "then": [
        {
          "actor": "agent",
          "do": "get_workspace",
          "expect": {
            "activeWindow": null
          }
        }
      ]
    },
    {
      "name": "a same-site claim is cross-site too",
      "setup": [],
      "request": {
        "method": "POST",
        "path": "claim",
        "headers": {
          "Sec-Fetch-Site": "same-site"
        },
        "body": {
          "windowId": "w-A",
          "seq": 41,
          "shown": true,
          "state": "$sample"
        }
      },
      "expect": {
        "status": 403,
        "body": {
          "code": "cross_site"
        }
      }
    },
    {
      "name": "a same-origin claim",
      "setup": [],
      "request": {
        "method": "POST",
        "path": "claim",
        "headers": {
          "Sec-Fetch-Site": "same-origin"
        },
        "body": {
          "windowId": "w-A",
          "seq": 41,
          "shown": true,
          "state": "$sample"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "a claim body over 128 KiB",
      "setup": [],
      "request": {
        "method": "POST",
        "path": "claim",
        "body": {
          "windowId": "w-A",
          "seq": 41,
          "shown": true,
          "state": "$sample"
        },
        "padTo": 131073
      },
      "expect": {
        "status": 413,
        "body": {
          "code": "too_large"
        }
      }
    },
    {
      "name": "a claim body of exactly 128 KiB",
      "setup": [],
      "request": {
        "method": "POST",
        "path": "claim",
        "body": {
          "windowId": "w-A",
          "seq": 41,
          "shown": true,
          "state": "$sample"
        },
        "padTo": 131072
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "a key outside the member-key grammar",
      "setup": [],
      "request": {
        "method": "POST",
        "path": "claim",
        "body": {
          "windowId": "w-A",
          "seq": 1,
          "shown": true,
          "state": {
            "tabs": [
              {
                "key": "library/linac/LinacView?SR=1 2",
                "kind": "screen",
                "canBack": false,
                "canForward": false
              }
            ],
            "active": null,
            "layout": {
              "tile": "t1",
              "tabs": [
                "library/linac/LinacView?SR=1 2"
              ],
              "showing": "library/linac/LinacView?SR=1 2"
            },
            "zoom": {},
            "instances": {},
            "toolMru": [],
            "labels": {}
          }
        }
      },
      "expect": {
        "status": 422,
        "body": {
          "code": "invalid_state"
        }
      }
    },
    {
      "name": "a key with more than 16 macros",
      "setup": [],
      "request": {
        "method": "POST",
        "path": "claim",
        "body": {
          "windowId": "w-A",
          "seq": 1,
          "shown": true,
          "state": {
            "tabs": [
              {
                "key": "library/linac/LinacView?M00=v&M01=v&M02=v&M03=v&M04=v&M05=v&M06=v&M07=v&M08=v&M09=v&M10=v&M11=v&M12=v&M13=v&M14=v&M15=v&M16=v",
                "kind": "screen",
                "canBack": false,
                "canForward": false
              }
            ],
            "active": "library/linac/LinacView?M00=v&M01=v&M02=v&M03=v&M04=v&M05=v&M06=v&M07=v&M08=v&M09=v&M10=v&M11=v&M12=v&M13=v&M14=v&M15=v&M16=v",
            "layout": {
              "tile": "t1",
              "tabs": [
                "library/linac/LinacView?M00=v&M01=v&M02=v&M03=v&M04=v&M05=v&M06=v&M07=v&M08=v&M09=v&M10=v&M11=v&M12=v&M13=v&M14=v&M15=v&M16=v"
              ],
              "showing": "library/linac/LinacView?M00=v&M01=v&M02=v&M03=v&M04=v&M05=v&M06=v&M07=v&M08=v&M09=v&M10=v&M11=v&M12=v&M13=v&M14=v&M15=v&M16=v"
            },
            "zoom": {
              "library/linac/LinacView": {
                "mode": "fit"
              }
            },
            "instances": {},
            "toolMru": [],
            "labels": {}
          }
        }
      },
      "expect": {
        "status": 422,
        "body": {
          "code": "invalid_state"
        }
      }
    }
  ]
}
