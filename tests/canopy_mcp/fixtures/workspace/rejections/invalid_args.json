          "seq": 41
        },
        "commands": [
          {
            "id": "c-e1-1",
            "cmd": "open_tool",
            "args": {
              "tool": "trace",
              "query": "pv=A&range=yesterday"
            }
          }
        ]
      },
      "results": [
