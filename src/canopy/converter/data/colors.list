# Canopy converter — bundled EDM colors.list
#
# Purpose: screens declaring indexed colours ("fgColor index N", "bgColor
# index N", ...) convert deterministically without depending on the host's
# EDM install. The converter module points the EDM parser at this file via
# EDMCOLORFILE at startup (see canopy/converter/adapters/edm_env.py); point
# CANOPY_CONVERTER__COLORS_LIST_PATH at your site's colors.list for full
# fidelity.
#
# Provenance: the base palette below (version/settings/aliases, static
# indices 0-83, rules and alarm map) is copied VERBATIM from the SLAC EDM
# display corpus, file display/bcs/config/colors.list. A synthetic extension
# block at the end of this file adds neutral placeholders for the 17 residual
# indices (84..193) that corpus screens reference beyond the base palette —
# the full site palette is not redistributed here.
#
# Format: a version line ("major minor release"), "key = value" settings,
# 'alias' lines, then 'static <index> "<name>" { r g b }' entries (6
# components for a blinking colour), plus optional rule/menumap/alarm blocks.

4 0 0

blinkms=750
max=0x10000
columns=5

alias trace0 red-21
alias trace1 blue-26
alias trace2 cyan-31
alias trace3 yellow-36
alias trace4 orange-41
alias trace5 purple-46
alias trace6 "COOL title"
alias trace7 "CRYO title"
alias trace8 "RF title"
alias trace9 "UNSS title"

static 0   "Disconn/Invalid"  { 65535 65535 65535 }    #0 white
static 1   "grey-1"           { 60652 60652 60652 }    #
