  noalarm      : *
 }

# --- Synthetic extension (NOT site colours) ---------------------------------
# Neutral mid-grey placeholders covering the residual colour indices that
# corpus screens reference beyond the base palette above. They keep index
# resolution deterministic; replace by overriding
# CANOPY_CONVERTER__COLORS_LIST_PATH with the full site palette.
