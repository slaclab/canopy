# Sample Canopy environment file.
#
# Copy to `.env` (which is gitignored) and uncomment the lines you need.
# `pydantic-settings` reads `.env` automatically; values can also be passed
# via real environment variables, which override the file.

# === Core (canopy.core.config.Settings, prefix CANOPY_) ===
# CANOPY_DEBUG=false
# Root log level for the API and worker processes. An unknown name falls back to INFO.
# CANOPY_LOG_LEVEL=INFO

# === API keys (canopy.core.security.EnvKeyRegistry) ===
# Format: "<token>:<scope>[+<scope>]*[@<module>[+<module>]*][,<token>:<scope>...]".
# Scopes: read, write, admin. Modules restrict which mounted sub-app (mole, hare,
# raccoon, vole, fox, squirrel, magpie, jobs, converter) or "core" (the
# parent app's own routes, including /v1/api-keys) the key may call; omitting
# the "@..." suffix is deprecated but still works — it defaults to "@*" (every
# module) with a startup warning, so an entry written before module scoping
# existed keeps its old access.
# Keys defined here are checked BEFORE the Postgres-backed registry and keep working
# when the database is unreachable, so a deployment keeps a small long-lived set here
# (a read key for displays, an admin key for ops) and manages the rest in the database
# via scripts/create_key.py. Revocation is immediate in the process that ran the
# deactivate; every other replica still serves the cached key until CACHE_TTL_S below.
# Empty/unset is fine when the database registry has keys.
# CANOPY_API_KEYS="dev:read+write@*"
# CANOPY_API_KEYS="ro:read@*,rw:read+write@*,ops:admin@*"
# CANOPY_API_KEYS="trace:read@fox+vole"

# --- API key cache (all optional) ---
# How long a database-backed key stays cached. This IS the revocation latency:
# a key deactivated in the database keeps working until its entry expires.
# CANOPY_API_KEY_CACHE_TTL_S=60
# How long an unknown token is remembered as unknown, so guessing can't hammer the DB.
# CANOPY_API_KEY_NEGATIVE_CACHE_TTL_S=5
# Ceiling on serving a cached key while Postgres is unreachable. Keeps live data
# flowing through a data-layer outage without letting a revoked key live forever.
# CANOPY_API_KEY_MAX_STALE_S=3600

# === Persistence (canopy.core.config.Settings, prefix CANOPY_) ===
# Postgres is required by persistent modules (Squirrel). Use the asyncpg driver URL.
# CANOPY_DATABASE_URL=postgresql+asyncpg://canopy:canopy@localhost:5432/canopy
# CANOPY_DATABASE_POOL_SIZE=5
# CANOPY_DATABASE_MAX_OVERFLOW=10

# === Redis (canopy.core.config.Settings, prefix CANOPY_) ===
# Arq job queue + per-job progress; used by canopy-worker and the Jobs module.
# Must match REDIS_PASSWORD in docker/.env if using docker-compose.yml's redis service.
# CANOPY_REDIS_URL=redis://:canopy@localhost:6379/0

# === Mole (canopy.mole.config.MoleConfig, prefix CANOPY_MOLE__, nested __) ===
# `default_archiver` is the instance used when a request omits `?archiver=`.
# Each archiver lives under ARCHIVERS__<NAME>__<FIELD>.
# `URL` is the Appliance root (the adapter prefixes /mgmt and /retrieval itself).
# CANOPY_MOLE__DEFAULT_ARCHIVER=slac
# CANOPY_MOLE__ARCHIVERS__SLAC__TYPE=epics_archiver_appliance
# CANOPY_MOLE__ARCHIVERS__SLAC__URL=https://archiver.example.org
# CANOPY_MOLE__ARCHIVERS__SLAC__TIMEOUT_S=15.0
# Optional: name of another env var holding a bearer token for this archiver.
# CANOPY_MOLE__ARCHIVERS__SLAC__API_KEY_ENV=SLAC_ARCHIVER_TOKEN

# === EPICS connector (canopy.epics.config.EpicsConfig, prefix CANOPY_EPICS__, nested __) ===
# Shared live-PV connector used by Hare. `simulation` (default, synthetic, no IOC)
# or `epics` (real CA/PVA via aioca/p4p), or a
# `module:Class` dotted path to an out-of-tree backend.
# CANOPY_EPICS__BACKEND=simulation
# CANOPY_EPICS__SIM_UPDATE_HZ=5
# Simulated write failures, for exercising partial-failure paths without an IOC:
# the fraction of puts that fail (0.0-1.0), PVs whose puts always fail, and the
# seed that makes the failure sequence reproducible.
# CANOPY_EPICS__SIM_PUT_ERROR_RATE=0.0
# CANOPY_EPICS__SIM_PUT_FAIL_PVS=
# CANOPY_EPICS__SIM_SEED=
# CANOPY_EPICS__BACKEND=epics
# CANOPY_EPICS__CA_TIMEOUT_S=5
# CANOPY_EPICS__PVA_TIMEOUT_S=5
# CANOPY_EPICS__UNPREFIXED_PVA_FALLBACK=false
# EPICS network discovery uses the libraries' own env vars (EPICS_CA_ADDR_LIST, ...).

# === Hare (canopy.hare.config.HareConfig, prefix CANOPY_HARE__, nested __) ===
# WebSocket diff-stream batching window (ms) and heartbeat cadence (s).
# CANOPY_HARE__WS_BATCH_INTERVAL_MS=100
# CANOPY_HARE__HEARTBEAT_INTERVAL_S=5

# === Vole (canopy.vole.config.VoleConfig, prefix CANOPY_VOLE__, nested __) ===
# Maximum age of samples kept in a ring buffer (nanoseconds). Default: 1 hour.
# CANOPY_VOLE__MAX_AGE_NS=3600000000000
# Maximum number of samples per PV ring buffer.
# CANOPY_VOLE__MAX_POINTS=1000000
# Global memory ceiling (bytes) across all ring buffers. Default: 4 GiB.
# CANOPY_VOLE__GLOBAL_BYTES_MAX=4294967296
# Default alignment mode for cross-PV reads ("last", "linear", "nearest", "none").
# CANOPY_VOLE__DEFAULT_ALIGN=last
# Default index mode for cross-PV reads ("union", "intersection", "grid", "first_input").
# CANOPY_VOLE__DEFAULT_INDEX=union

# === Squirrel (canopy.squirrel.config.SquirrelConfig, prefix CANOPY_SQUIRREL__) ===
# Restore hooks: extra per-PV writes sent during a snapshot restore. Comma-separated
# provider keys, applied in order; once one hook's write fails for a PV, later hooks
# skip that PV. Empty/unset = no hook runs.
# `magnet_trim` puts TRIM to a magnet's CTRL PV; `write_to_con` mirrors a magnet's
# restored BDES value onto its BCON PV. The worker is what restores, so this must
# reach the worker process too. GET /squirrel/v1/health/restore-hooks shows what the
# worker reported loading at startup next to the API's view (matchesApi flags a gap).
# List write_to_con before magnet_trim, so a magnet is trimmed only once BCON holds
# the value being restored.
# CANOPY_SQUIRREL__RESTORE_HOOKS=write_to_con,magnet_trim
# PV cache for cached snapshots (POST /squirrel/v1/snapshots?useCache=true). When
# enabled, one canopy-worker (elected through a Redis lease) monitors every registered
# setpoint/readback address and keeps its latest value in Redis; cached snapshots take
# what it can vouch for and read the rest live. Without it, useCache=true reads every
# PV live. Set it on the worker; GET /squirrel/v1/health/pv-cache shows its state.
# CANOPY_SQUIRREL__PV_CACHE__ENABLED=true
# Re-read the registered PVs (add/drop monitors) every this many seconds.
# CANOPY_SQUIRREL__PV_CACHE__RECONCILE_INTERVAL_S=60
# Write buffered monitor updates (and the heartbeat) to Redis every this many seconds.
# CANOPY_SQUIRREL__PV_CACHE__FLUSH_INTERVAL_S=1
# Ignore the whole cache once its heartbeat is older than this (seconds).
# CANOPY_SQUIRREL__PV_CACHE__HEARTBEAT_MAX_AGE_S=30
# Leader lease length (seconds); the leader renews it every third of this.
# CANOPY_SQUIRREL__PV_CACHE__LEASE_TTL_S=30
# Monitors opened concurrently while (re)building the monitor set.
# CANOPY_SQUIRREL__PV_CACHE__SUBSCRIBE_CONCURRENCY=200

# === Fox (canopy.fox.config.FoxConfig, prefix CANOPY_FOX__, nested __) ===
# Maximum time (ms) a single formula evaluation may run before timing out.
# CANOPY_FOX__EVAL_TIMEOUT_MS=250
# Maximum number of output points returned by a curve evaluation.
# CANOPY_FOX__MAX_OUTPUT_POINTS=10000
# Maximum allowed length (characters) of an expression string.
# CANOPY_FOX__MAX_EXPRESSION_LEN=2048
