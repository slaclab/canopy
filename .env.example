# Sample Canopy environment file.
#
# Copy to `.env` (which is gitignored) and uncomment the lines you need.
# `pydantic-settings` reads `.env` automatically; values can also be passed
# via real environment variables, which override the file.

# === Core (canopy.core.config.Settings, prefix CANOPY_) ===
# CANOPY_DEBUG=false

# === API keys (canopy.core.security.EnvKeyRegistry) ===
# Format: "<token>:<scope>[+<scope>]*[,<token>:<scope>...]". Scopes: read, write.
# Empty/unset = no keys registered = every gated endpoint returns 401.
# CANOPY_API_KEYS="dev:read+write"
# CANOPY_API_KEYS="ro:read,rw:read+write"

# === Mole (canopy.mole.config.MoleConfig, prefix CANOPY_MOLE__, nested __) ===
# `default_archiver` is the instance used when a request omits `?archiver=`.
# Each archiver lives under ARCHIVERS__<NAME>__<FIELD>.
# `URL` is the Appliance root (the adapter prefixes /mgmt and /retrieval itself).
# CANOPY_MOLE__DEFAULT_ARCHIVER=slac
# CANOPY_MOLE__ARCHIVERS__SLAC__TYPE=epics_archiver_appliance
# CANOPY_MOLE__ARCHIVERS__SLAC__URL=https://archiver.example.org
# CANOPY_MOLE__ARCHIVERS__SLAC__TIMEOUT_S=15.0
# Optional: name of another env var holding a bearer token for this archiver.
# CANOPY_MOLE__ARCHIVERS__SLAC__API_KEY_ENV=SLAC_ARCHIVER_TOKEN
