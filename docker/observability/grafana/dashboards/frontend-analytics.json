{
  "uid": "canopy-frontend-analytics",
  "title": "Canopy Frontend Analytics",
  "tags": ["canopy", "analytics"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "timezone": "browser",
  "templating": { "list": [] },
  "panels": [
    {
      "type": "timeseries",
      "title": "Analytics events",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "canopy-loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({app=\"canopy\", type=\"analytics\"}[$__interval]))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Events by name",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "loki", "uid": "canopy-loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (event) (count_over_time({app=\"canopy\", type=\"analytics\"} | json [$__interval]))",
          "legendFormat": "{{event}}"
        }
      ]
    },
    {
      "type": "bargauge",
      "title": "Top routes",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "loki", "uid": "canopy-loki" },
      "options": { "displayMode": "gradient", "orientation": "horizontal" },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (route) (count_over_time({app=\"canopy\", type=\"analytics\"} | json | route != \"\" [$__range])))",
          "legendFormat": "{{route}}",
          "instant": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Keyed vs anonymous clients",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "loki", "uid": "canopy-loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (has_api_key) (count_over_time({app=\"canopy\", type=\"analytics\"} | json [$__interval]))",
          "legendFormat": "has_api_key={{has_api_key}}"
        }
      ]
    }
  ]
}
