# =============================================================================
# Canopy Docker Environment Configuration
# =============================================================================
# Copy to .env: cp .env.example .env
# =============================================================================
COMPOSE_PROJECT_NAME=canopy

# --- Service Ports -----------------------------------------------------------
API_HOST_PORT=8000

# --- App Configuration -------------------------------------------------------
CANOPY_DEBUG=true
CANOPY_API_KEYS=dev:read+write

# --- EPICS Backend -----------------------------------------------------------
# "simulation" (default, no IOC needed) or "epics" (real CA/PVA)
CANOPY_EPICS__BACKEND=simulation

# --- EPICS Channel Access (only when BACKEND=epics) --------------------------
# EPICS_CA_ADDR_LIST=
# EPICS_CA_AUTO_ADDR_LIST=YES
# EPICS_CA_SERVER_PORT=5064
# EPICS_CA_REPEATER_PORT=5065

# --- EPICS PV Access (only when BACKEND=epics) -------------------------------
# EPICS_PVA_ADDR_LIST=
# EPICS_PVA_AUTO_ADDR_LIST=YES
# EPICS_PVA_SERVER_PORT=5075
# EPICS_PVA_BROADCAST_PORT=5076

# --- Mole (Archiver Proxy) --------------------------------------------------
# CANOPY_MOLE__DEFAULT_ARCHIVER=slac
# CANOPY_MOLE__ARCHIVERS__SLAC__TYPE=epics_archiver_appliance
# CANOPY_MOLE__ARCHIVERS__SLAC__URL=https://archiver.example.org

# --- Production Image (for docker-compose.prod.yml) --------------------------
# IMAGE=ghcr.io/slaclab/canopy:latest
