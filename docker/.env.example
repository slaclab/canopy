# =============================================================================
# Canopy Docker Environment Configuration
# =============================================================================
# Copy to .env: cp .env.example .env
# =============================================================================
COMPOSE_PROJECT_NAME=canopy

# --- Service Ports -----------------------------------------------------------
API_HOST_PORT=8000

# --- Redis ---------------------------------------------------------------
# Required: redis-server refuses to start without this (--requirepass).
# The redis port is also bound to 127.0.0.1 only, so it's never reachable
# from the network even with a weak password.
REDIS_PASSWORD=canopy

# --- App Configuration -------------------------------------------------------
CANOPY_DEBUG=true
CANOPY_API_KEYS=dev:read+write

# --- EPICS Backend -----------------------------------------------------------
# "simulation" (default, no IOC needed) or "epics" (real CA/PVA)
CANOPY_EPICS__BACKEND=simulation

# --- EPICS Network (only when BACKEND=epics) ---------------------------------
# Points at host machine from inside Docker; disable broadcast discovery.
# Uncomment these when switching to BACKEND=epics with a local IOC.
# EPICS_CA_ADDR_LIST=host.docker.internal
# EPICS_CA_AUTO_ADDR_LIST=NO
# EPICS_PVA_ADDR_LIST=host.docker.internal
# EPICS_PVA_AUTO_ADDR_LIST=NO

# --- Mole (Archiver Proxy) --------------------------------------------------
# CANOPY_MOLE__DEFAULT_ARCHIVER=slac
# CANOPY_MOLE__ARCHIVERS__SLAC__TYPE=epics_archiver_appliance
# CANOPY_MOLE__ARCHIVERS__SLAC__URL=https://archiver.example.org

# --- Production Image (for docker-compose.prod.yml) --------------------------
# IMAGE=ghcr.io/slaclab/canopy:latest
