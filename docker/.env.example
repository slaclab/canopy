# =============================================================================
# Canopy Docker Environment Configuration
# =============================================================================
# Copy to .env: cp .env.example .env
# =============================================================================
COMPOSE_PROJECT_NAME=canopy

# --- Service Ports -----------------------------------------------------------
API_HOST_PORT=8000

# --- Redis ---------------------------------------------------------------
# Required: redis-server refuses to start without this (--requirepass).
# The redis port is also bound to 127.0.0.1 only, so it's never reachable
# from the network even with a weak password.
REDIS_PASSWORD=canopy

# --- App Configuration -------------------------------------------------------
CANOPY_DEBUG=true
CANOPY_LOG_LEVEL=INFO
# Checked before the Postgres-backed registry; survives a database outage.
# Scopes: read, write, admin. The @<module>[+<module>] suffix is required — use
# @* for every module (e.g. dev:read@formula-engine+vole for two specific modules). Manage
# non-critical keys with scripts/create_key.py.
CANOPY_API_KEYS=dev:read+write@*

# --- EPICS Backend -----------------------------------------------------------
# "simulation" (default, no IOC needed) or "epics" (real CA/PVA)
CANOPY_EPICS__BACKEND=simulation

# Simulated write failures (BACKEND=simulation only), for exercising snapshot
# restore's partial-failure paths without an IOC: the fraction of puts that fail
# (0.0-1.0), PVs whose puts always fail, and the seed that makes the failure
# sequence reproducible.
# CANOPY_EPICS__SIM_PUT_ERROR_RATE=0.0
# CANOPY_EPICS__SIM_PUT_FAIL_PVS=
# CANOPY_EPICS__SIM_SEED=

# --- EPICS Network (only when BACKEND=epics) ---------------------------------
# Points at host machine from inside Docker; disable broadcast discovery.
# Uncomment these when switching to BACKEND=epics with a local IOC.
# EPICS_CA_ADDR_LIST=host.docker.internal
# EPICS_CA_AUTO_ADDR_LIST=NO
# EPICS_PVA_ADDR_LIST=host.docker.internal
# EPICS_PVA_AUTO_ADDR_LIST=NO

# --- Squirrel ----------------------------------------------------------------
# Restore hooks: extra per-PV writes sent during a snapshot restore. Comma-separated,
# applied in order; a PV one hook fails on skips the later ones. Providers:
# write_to_con, magnet_trim (list them in that order). Empty = no hook runs.
# Confirm what the worker actually loaded with: GET /squirrel/v1/health/restore-hooks
CANOPY_SQUIRREL__RESTORE_HOOKS=

# --- Mole (Archiver Proxy) --------------------------------------------------
# CANOPY_MOLE__DEFAULT_ARCHIVER=slac
# CANOPY_MOLE__ARCHIVERS__SLAC__TYPE=epics_archiver_appliance
# CANOPY_MOLE__ARCHIVERS__SLAC__URL=https://archiver.example.org

# --- Production Image (for docker-compose.prod.yml) --------------------------
# IMAGE=ghcr.io/slaclab/canopy:latest
